# ============================================================
# Kraus Law Office - Environment Variables
# Copy this file to .env.local and fill in your keys
# ============================================================

# --- OpenAI (powers the RAG chatbot) ---
# Get at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# --- Resend (powers the contact form -> email) ---
# Get at: https://resend.com/api-keys  (free tier: 100 emails/day)
RESEND_API_KEY=re_...
CONTACT_TO_EMAIL=grace@krauslaw.example
CONTACT_FROM_EMAIL=intake@krauslaw.example

# --- Vapi.ai (powers the AI phone receptionist) ---
# Get at: https://dashboard.vapi.ai/
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
VAPI_WEBHOOK_SECRET=

# --- Site config ---
NEXT_PUBLIC_SITE_URL=https://krauslaw.example
NEXT_PUBLIC_PHONE=(630) 555-0100
NEXT_PUBLIC_ADDRESS=269 N Oaklawn Ave, Elmhurst, IL 60126
